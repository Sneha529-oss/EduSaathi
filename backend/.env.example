# EduSaathi Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────
# Gemini AI (Required for Phase 3 LLM features)
# Get your key at https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=

# The Gemini model to use. Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────
# Security — JWT token signing secret
# Use a long random string (>= 32 characters) in production
# ─────────────────────────────────────────────
SECRET_KEY=edusaathi_development_secret_key_change_in_production

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL=sqlite:///./edusaathi.db

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_ENV=development
