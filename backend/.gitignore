# ─────────────────────────────────────────────
# EduSaathi Backend .gitignore
# ─────────────────────────────────────────────

# Environment variables — NEVER commit .env
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage

# SQLite database (local dev only)
*.db
*.sqlite3

# Virtual environment
venv/
.venv/
env/

# Distribution / packaging
dist/
build/
*.egg-info/
